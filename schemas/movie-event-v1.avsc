{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "cinema.events",
  "doc": "Movie events schema v1. The Kafka key is user_id encoded as UTF-8.",
  "fields": [
    {"name": "event_id", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "user_id", "type": "string"},
    {"name": "movie_id", "type": "string"},
    {"name": "event_type", "type": {"type": "enum", "name": "EventType", "symbols": ["VIEW_STARTED", "VIEW_FINISHED", "VIEW_PAUSED", "VIEW_RESUMED", "LIKED", "SEARCHED"]}},
    {"name": "timestamp", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "UTC instant"},
    {"name": "device_type", "type": {"type": "enum", "name": "DeviceType", "symbols": ["MOBILE", "DESKTOP", "TV", "TABLET"]}},
    {"name": "session_id", "type": "string"},
    {"name": "progress_seconds", "type": "int", "doc": "Nonnegative playback position. Use zero for other events."}
  ]
}
