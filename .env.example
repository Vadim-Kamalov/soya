# Local development values; docker-compose up works without copying this file.
GRPC_API_KEY=local-development-key
FLIGHT_DB_PASSWORD=flight_dev
BOOKING_DB_PASSWORD=booking_dev
BOOKING_PORT=8080
CACHE_TTL_SECONDS=300
# Stable private Redis/Sentinel addresses; change if this subnet is already used.
REDIS_NET_PREFIX=172.30.76
GRPC_TIMEOUT_SECONDS=2
GRPC_BACKOFF_SECONDS=0.1
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_SECONDS=10
CB_WINDOW_SECONDS=30
RECOVERY_INTERVAL_SECONDS=5
RECOVERY_GRACE_SECONDS=30
